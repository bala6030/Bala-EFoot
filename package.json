{
  "name": "bala-efoot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "import-data": "python3 scripts/import_player_data.py",
    "test": "npm run test:squad && npm run test:season && npm run test:dashboard && npm run test:stats && npm run test:skills-wishlist",
    "test:squad": "node scripts/test_squad_builder.js",
    "test:season": "node scripts/test_season_repository.js",
    "test:dashboard": "node scripts/test_dashboard_integration.js",
    "test:stats": "node --import ./scripts/register-hooks.js scripts/test_stats_records.js",
    "test:skills-wishlist": "node --import ./scripts/register-hooks.js scripts/test_skills_wishlist.js"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
